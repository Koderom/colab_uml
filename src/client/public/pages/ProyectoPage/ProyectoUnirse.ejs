<div class="modal-form" style="display: none;" id="unirse_proyecto_form">
    <div class="form">
        <form >
            <h3>Unirse a proyecto existente</h3>
            <div class="row mb-3">
              <label for="inputEmail3" class="col-sm-2 col-form-label" >Ingrese el ID del proyecto</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" id="inputEmail3" name="id_proyecto">
              </div>
            </div>
            <input type="hidden" name="idEmpleado" value="<%= idEmpleado %>">
            <button type="submit" class="btn btn-primary" id="btn_unirse_proyecto">Unirse</button>
            <button type="button" class="btn btn-secondary " id="btn_unirse_proyecto_salir">Atras</button>
          </form>
    </div>  
</div>