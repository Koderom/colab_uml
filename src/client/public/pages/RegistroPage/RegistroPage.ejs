<%+ extend('./Layouts/MainLayout') %>


<%+ section('Styles')%>
<style>
    * {
    padding: 0;
    margin: 0;
    box-sizing: border-box;
    font-size: 14px;
}

body {
    width: 100vw;
    height: 100vh;
    background-image: url('../../assets/images/back_ground_image.jpg');
    background-repeat: no-repeat;
    /* Do not repeat the image */
    background-size: cover;
    justify-self: center;
    overflow: hidden;

    display: flex;
    justify-content: center;
    align-items: center;
}

button{
    font-size: 16px;
    justify-self: flex-end;
}
.form-container{
    width: 500px;
    height: fit-content;
    position: relative;
    top: -5rem;
    background: rgb(231, 231, 231);
    border-radius: 10px;
    box-shadow: 0 0 5px 10px rgba(0, 0, 0, 0.2);

    padding: 1rem;
    display: flex;
    flex-direction: column;
}
.login-title{
    align-self: center;
    font-size: 18px;
}
.form-label, .form-input, .form-button{
    font-size: 14px;
}
.form-option-container{
    display: flex;
    flex-direction: row;
    justify-content: end;
}
</style>
<%+ endSection%>

<%+ section('Content')  %>
<div class="form-container colorful-form">
    <h3 class="login-title">Registro de nuevo usuario</h3>
    <form class="form" method="post"
        enctype="application/x-www-form-urlencoded" id="form-registro">
        <div class="form-group">         
            <label class="form-label" for="login-name">Nombre y Apellido: </label>
            <input class="form-input" type="text" id="login-name" name="empleado_nombre" value='' required>
        </div>
        <div class="form-group">         
            <label class="form-label" for="login-name">Cargo: </label>
            <input class="form-input" type="text" id="login-name" name="empleado_cargo" value='' required>
        </div>

        <div class="form-group">         
            <label class="form-label" for="login-name">Nombre de usuario: </label>
            <input class="form-input" type="text" id="login-name" name="usuario_nombre" value='' required>
        </div>
        <div class="form-group">
            <label class="form-label" for="login-password">Contraseña: </label>
            <input class="form-input" type="password" id="login-password" name="usuario_password" value='' required>
        </div>
        
        <div class="form-option-container">
            <a href="/" class="btn btn-sm btn-primary  m-1">Login</a>
            <button class="btn btn-sm btn-secondary  m-1 " type="submit" id="btn-registro ">Registro</button>
        </div>
    </form>
    <span id="infoMessage"></span>
</div>
<%+ endSection %>

<%+ section('Scripts')%>
    <script type="module" src="./pages/RegistroPage/RegistroPage.js"></script>

<%+ endSection%>