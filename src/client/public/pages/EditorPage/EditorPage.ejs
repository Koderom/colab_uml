  <%+ extend('./Layouts/MainLayout') %>

<%+ section('Styles')%>
<style>
    body {
        display: flex;
        flex-direction: column;
        height: 100dvh;
    }
    main {
        flex-grow: 1;
    }
    #studio {
        height: 100%;
    }
    .gjs-block {
      width: fit-content !important;
      height: fit-content !important;
      min-height: auto;
    }

</style>
<style>
  .import-export-card {
      position: fixed;
      bottom: 20px;
      left: 20px;
      background-color: white;
      border-radius: 12px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
      padding: 12px;
      display: flex;
      gap: 12px;
      z-index: 999;
    }

    .card-button {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 8px 12px;
      background-color: #f5f5f5;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    .card-button:hover {
      background-color: #e0e0e0;
    }

    .card-button svg {
      width: 20px;
      height: 20px;
    }
</style>

<link rel="stylesheet" href="https://unpkg.com/grapesjs/dist/css/grapes.min.css"/>

<%+ endSection%>

<%+ section('Content')  %>
  <div id="gjs" style="height:0px; overflow:hidden" data-id-Editor="<%= editor.id %>"></div>
  <!-- <div id="blocks" style="width: 100%; height: 350px; overflow-y: scroll;"></div> -->

  <div class="import-export-card">
    <button id="import-button" class="card-button">
      <i data-lucide="upload"></i>
      <span>Importar</span>
    </button>
    <button id="export-button" class="card-button">
      <i class="fa-brands fa-angular"></i>
      <span>Exportar</span>
    </button>
  </div>
<%+ endSection %>

<%+ section('Scripts')%>
  <script src="https://unpkg.com/grapesjs-plugin-forms"></script>
  <script src="https://unpkg.com/grapesjs-navbar"></script>
  <script src="https://unpkg.com/grapesjs-preset-webpage"></script>
  <script src="https://unpkg.com/grapesjs-blocks-basic"></script>
  <!-- <script src=".\libraries\grapesjs\plugins\grapesjs-blocks-bootstrap4.min.js"></script> -->
  <script src="https://unpkg.com/grapesjs"></script>

  <script>
    var editorData = "<%= editor.jsondata%>";
  </script>

  <script type="module" src="./pages/EditorPage/EditorPage.js"></script>
<%+ endSection%>