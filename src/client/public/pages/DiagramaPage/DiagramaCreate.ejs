<div class="modal-form" style="display: none;" id="create_diagrama_form">
    <div class="form">
        <form >
            <h3>Nuevo diagrama</h3>
            <div class="row mb-3">
              <label for="inputEmail3" class="col-sm-2 col-form-label" >Nombre</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" id="inputEmail3" name="diagrama_nombre" required>
              </div>
            </div>
            <input type="hidden" name="idProyecto" value="<%= idProyecto %>">

            <button type="submit" class="btn btn-primary" id="btn_nuevo_diagrama_create">Crear</button>
            <button type="button" class="btn btn-secondary " id="btn_nuevo_diagrama_atras">Atras</button>
          </form>
    </div>  
</div>