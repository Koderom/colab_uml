<%+ extend('./Layouts/MainLayout') %>
<%+ section('Styles')%>
    <style>
        .modal-form{
            position: absolute;
            top: 0;
            width: 100vw;
            height: 100vh;
            align-items: start;
            justify-content: center;
            background: rgba(173, 173, 173, 0.56);
        }
        .modal-form>.form{
            padding: 2rem;
            margin-top: 5rem;
            width: 40rem;
            height: auto;
            border-radius: 1rem;
            background: white;
        }
    </style>
<%+ endSection%>

<%+ section('Navbar')%>
    <%- include('NavBarLayout', {idEmpleado: idEmpleado}) %> 
<%+ endSection%>

<%+ section('Content')  %>
    <div class="container bg-light" style="margin-top: 5rem; width: 100%; height: 100%;">
        <div class="row">
            <% proyectos.forEach( function(proyecto){ %>
                <div class="col-sm-3 card m-1 p-0">
                    <div class="card-body proyecto-item">
                        <h5 class="card-title"> <%= proyecto.titulo %></h5>
                        <p class="card-text"> <%= proyecto.descripcion %></p>
                        <a class="btn btn-secondary btn-sm" 
                            id="btn_ver_proyecto"
                            data-id-Empleado="<%= idEmpleado %>"
                            data-id-Proyecto="<%= proyecto.id %>">
                            ver
                        </a>
                        <a class="btn btn-secondary btn-sm" 
                            id="btn_join_proyecto"
                            data-join-code="<%= proyecto.joinCode%>">
                            compartir
                        </a>
                    </div>
                </div>
            <% }); %>

            <div class="col-sm-3 card m-1 p-0">
                <div class="card-body ">
                    <h5 class="card-title">Nuevo proyecto</h5>
                    <p class="card-text">Crea un nuevo proyecto, agrega diagramas y colaboradores</p>
                    <a class="btn btn-primary btn-sm" id="btn_nuevo_proyecto">Nuevo</a>
                    <a class="btn btn-info btn-sm" id="btn_unirse_proyecto">Unirse</a>
                </div>
            </div>
        </div>
    </div>
    
    <%- include('../ProyectoPage/ProyectoCreate', {idEmpleado: idEmpleado}) %>
    <%- include('../ProyectoPage/ProyectoUnirse', {idEmpleado: idEmpleado}) %>
<%+ endSection %>
<%+ section('Scripts')%>
    <script type="module" src="./pages/ProyectoPage/ProyectoPage.js"></script>
<%+ endSection%>